{
	# HTTPS is offloaded by the upstream load balancer.
	# We listen plain HTTP on :8100 only; no auto-TLS.
	auto_https off

	# Which peers' X-Forwarded-For / -Proto / -Host are passed on. Caddy does NOT
	# decide which address is the person's: it keeps the incoming X-Forwarded-For of
	# a trusted peer and appends the address it was connected from (an untrusted
	# peer's header is replaced by that address), and the API picks the entry by the
	# admin's "Trusted proxies" and "Strict proxy mode" settings (Admin > Settings >
	# Authentication; packages/shared/src/client-ip.ts). So never set
	# X-Forwarded-For with header_up here: that would hide the chain from the API.
	#
	# TRUSTED_PROXIES in .env (the older way to configure this) narrows which peers
	# Caddy believes at all, and the API uses it while the setting is blank. Unset,
	# every peer is passed on and the settings decide.
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:0.0.0.0/0}
		{$TRUSTED_PROXIES_STRICT:}
	}

	log default {
		output stdout
		format console
		level INFO
	}
}

:8100 {
	encode gzip zstd

	# Baseline security headers, applied to every response. Each:
	#   X-Content-Type-Options nosniff — keeps browsers from MIME-sniffing
	#     past the declared content-type (already set per-route on attachment
	#     downloads, but defence-in-depth for everything else).
	#   X-Frame-Options DENY — kills clickjacking. We never embed this site
	#     in an iframe, including from itself.
	#   Referrer-Policy strict-origin-when-cross-origin — leaks only the
	#     origin (not the path) when navigating to external links.
	#   Permissions-Policy — disable browser features we never use.
	#   Content-Security-Policy — a baseline for every response (scripts and
	#     styles from self, no eval). img-src is wider to allow OAuth-provided
	#     avatars (Google/Microsoft) and data: URIs. The web app's middleware
	#     adds a stricter per-request policy to its pages (script nonce, no
	#     inline scripts); the browser enforces both, so the stricter one
	#     decides for pages. 'unsafe-inline' here is only the fallback for
	#     responses that do not pass through that middleware.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ws: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		# HSTS deliberately omitted — HTTPS termination is upstream of Caddy
		# (per CLAUDE.md), so it's the LB's job to set HSTS.
	}

	# We pass the *original* Host header through to every upstream so Auth.js
	# (trustHost: true) and any other URL-building code reconstruct the public
	# origin from the hostname the user actually typed — localhost, a LAN IP,
	# docker01.example.com, an upstream HTTPS LB, whatever — without any
	# value baked into env or code.
	#
	# Caddy v2's default is to rewrite Host to the upstream address (e.g.
	# web:3000). The `header_up Host {host}` lines below override that so the
	# upstream sees the same Host the client sent.

	# Load balancer health check. 200 only while this node's API can reach the
	# database (the API's readiness answers 503 otherwise, and a dead API gives
	# 502). It answers 503 "draining" while the flag file data/caddy/drain exists
	# (`scripts/cluster.sh drain`), so a node can be taken out of rotation before
	# an upgrade without touching the load balancer. The node name is returned in
	# a header to make a check easy to attribute.
	handle /healthz {
		header X-Lampstand-Node "{$NODE_ID:unknown}"
		@draining file {
			root /data
			try_files drain
		}
		respond @draining "draining" 503
		rewrite * /api/v1/readyz
		reverse_proxy api:3001 {
			header_up Host {host}
		}
	}

	# Next's image optimizer is unused (next.config.mjs images.unoptimized) and has had RCE, SSRF and DoS
	# advisories; it is never reachable from outside.
	handle /_next/image* {
		respond "Not found" 404
	}

	# Internal-only endpoints that hand out secrets (OAuth client_id/secret) or
	# accept un-authenticated state mutations. The web container reaches these
	# directly via api:3001 on the docker bridge — they have no business being
	# reachable from the public proxy. Defence-in-depth alongside the
	# X-Internal-Token check on the controller side.
	@internal_only path /api/v1/auth/providers/internal* /api/v1/auth/verify-credentials* /api/v1/users/ensure-default-group* /api/v1/users/oauth-provision*
	handle @internal_only {
		respond "Not found" 404
	}

	# The assistant's answers are server-sent events: pass each chunk on at once (flush_interval -1), never buffered.
	handle /api/v1/assistant/chat {
		reverse_proxy api:3001 {
			header_up Host {host}
			flush_interval -1
		}
	}

	handle /api/v1/* {
		reverse_proxy api:3001 {
			header_up Host {host}
		}
	}

	handle /socket.io/* {
		reverse_proxy api:3001 {
			header_up Host {host}
		}
	}

	handle {
		reverse_proxy web:3000 {
			header_up Host {host}
		}
	}
}
